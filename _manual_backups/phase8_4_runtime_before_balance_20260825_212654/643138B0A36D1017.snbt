  quests: [
  {
    id: "22A15C3103B3C972"
    title: "За воротами"
    icon: "minecraft:iron_door"
    tags: ["ds_visual_story"]
    x: 0.0d
    y: 0.0d
    shape: "hexagon"
    size: 1.22d
    icon_scale: 0.84d
    min_width: 340
    dependencies: ["20BBB183D71C8B21"]
    description: [
      "Купол стал домом, но часть нужных материалов лежит снаружи.",
      "",
      "Пока у нас нет собственного запаса переносного кислорода. Поэтому эта глава не про экспедиции — только про короткие контролируемые выходы вокруг шлюза.",
      "",
      "Задача проста: подготовиться, выйти, сделать одно дело и вернуться раньше, чем риск станет бессмысленным.",
      "",
      "{\"text\":\"◆ Что сделать\",\"color\":\"gold\",\"bold\":true}",
      "{\"text\":\"Завершите финальный квест Главы 1 «Первые дни».\",\"color\":\"white\"}",
      "",
      "{\"text\":\"◆ Как засчитывается\",\"color\":\"aqua\",\"bold\":true}",
      "{\"text\":\"Автоматически после выполнения зависимости.\",\"color\":\"gray\"}",
      "",
      "{\"text\":\"⚠ Важно\",\"color\":\"yellow\",\"bold\":true}",
      "{\"text\":\"Никаких дальних структур, ночёвок и глубоких шахт в этой главе.\",\"color\":\"yellow\"}"
    ]
    tasks: [
      {
          id: "0CBC14A92FAECBFB"
          type: "advancement"
          title: "Автоматически: intro"
          advancement: "domesurvival:quest_actions/ch2_intro"
