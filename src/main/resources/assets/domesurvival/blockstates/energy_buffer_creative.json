{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "domesurvival:block/energy_buffer_creative"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "domesurvival:block/energy_buffer_creative",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "domesurvival:block/energy_buffer_creative",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "domesurvival:block/energy_buffer_creative",
        "y": 270
      }
    },
    {
      "when": {
        "port_up": "input"
      },
      "apply": {
        "model": "domesurvival:block/machine_input_port_up"
      }
    },
    {
      "when": {
        "port_up": "output"
      },
      "apply": {
        "model": "domesurvival:block/machine_output_port_up"
      }
    },
    {
      "when": {
        "port_down": "input"
      },
      "apply": {
        "model": "domesurvival:block/machine_input_port_down"
      }
    },
    {
      "when": {
        "port_down": "output"
      },
      "apply": {
        "model": "domesurvival:block/machine_output_port_down"
      }
    },
    {
      "when": {
        "port_north": "input"
      },
      "apply": {
        "model": "domesurvival:block/machine_input_port_north"
      }
    },
    {
      "when": {
        "port_north": "output"
      },
      "apply": {
        "model": "domesurvival:block/machine_output_port_north"
      }
    },
    {
      "when": {
        "port_south": "input"
      },
      "apply": {
        "model": "domesurvival:block/machine_input_port_south"
      }
    },
    {
      "when": {
        "port_south": "output"
      },
      "apply": {
        "model": "domesurvival:block/machine_output_port_south"
      }
    },
    {
      "when": {
        "port_west": "input"
      },
      "apply": {
        "model": "domesurvival:block/machine_input_port_west"
      }
    },
    {
      "when": {
        "port_west": "output"
      },
      "apply": {
        "model": "domesurvival:block/machine_output_port_west"
      }
    },
    {
      "when": {
        "port_east": "input"
      },
      "apply": {
        "model": "domesurvival:block/machine_input_port_east"
      }
    },
    {
      "when": {
        "port_east": "output"
      },
      "apply": {
        "model": "domesurvival:block/machine_output_port_east"
      }
    }
  ]
}