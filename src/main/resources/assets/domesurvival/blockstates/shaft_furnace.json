{
  "multipart": [
    { "when": { "facing": "north", "lit": "false" }, "apply": { "model": "domesurvival:block/shaft_furnace_ready" } },
    { "when": { "facing": "east",  "lit": "false" }, "apply": { "model": "domesurvival:block/shaft_furnace_ready", "y": 90 } },
    { "when": { "facing": "south", "lit": "false" }, "apply": { "model": "domesurvival:block/shaft_furnace_ready", "y": 180 } },
    { "when": { "facing": "west",  "lit": "false" }, "apply": { "model": "domesurvival:block/shaft_furnace_ready", "y": 270 } },
    { "when": { "facing": "north", "lit": "true" }, "apply": { "model": "domesurvival:block/shaft_furnace_ready_on" } },
    { "when": { "facing": "east",  "lit": "true" }, "apply": { "model": "domesurvival:block/shaft_furnace_ready_on", "y": 90 } },
    { "when": { "facing": "south", "lit": "true" }, "apply": { "model": "domesurvival:block/shaft_furnace_ready_on", "y": 180 } },
    { "when": { "facing": "west",  "lit": "true" }, "apply": { "model": "domesurvival:block/shaft_furnace_ready_on", "y": 270 } },

    { "apply": { "model": "domesurvival:block/shaft_furnace_bottom_output" } }
  ]
}
