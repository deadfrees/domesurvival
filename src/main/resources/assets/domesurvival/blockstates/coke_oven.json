{
  "multipart": [
    { "when": { "facing": "north", "lit": "false" }, "apply": { "model": "domesurvival:block/coke_oven_ready" } },
    { "when": { "facing": "east",  "lit": "false" }, "apply": { "model": "domesurvival:block/coke_oven_ready", "y": 90 } },
    { "when": { "facing": "south", "lit": "false" }, "apply": { "model": "domesurvival:block/coke_oven_ready", "y": 180 } },
    { "when": { "facing": "west",  "lit": "false" }, "apply": { "model": "domesurvival:block/coke_oven_ready", "y": 270 } },
    { "when": { "facing": "north", "lit": "true" }, "apply": { "model": "domesurvival:block/coke_oven_ready_on" } },
    { "when": { "facing": "east",  "lit": "true" }, "apply": { "model": "domesurvival:block/coke_oven_ready_on", "y": 90 } },
    { "when": { "facing": "south", "lit": "true" }, "apply": { "model": "domesurvival:block/coke_oven_ready_on", "y": 180 } },
    { "when": { "facing": "west",  "lit": "true" }, "apply": { "model": "domesurvival:block/coke_oven_ready_on", "y": 270 } },

    { "apply": { "model": "domesurvival:block/coke_oven_bottom_output" } }
  ]
}
