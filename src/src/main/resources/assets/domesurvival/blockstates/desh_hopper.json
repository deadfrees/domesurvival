{
  "multipart": [
    {
      "when": {
        "facing": "down"
      },
      "apply": {
        "model": "domesurvival:block/desh_hopper_down"
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "domesurvival:block/desh_hopper"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "domesurvival:block/desh_hopper",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "domesurvival:block/desh_hopper",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "domesurvival:block/desh_hopper",
        "y": 270
      }
    }
  ]
}
