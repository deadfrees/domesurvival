-        if (!simulate && extracted > 0) {
-            int removed = energyStorage.removeEnergyInternal(extracted);
-            extractedThisTick += removed;
-
-            if (removed > 0) {
-                active = true;
-                setChanged();
-            }
-
-            return removed;
-        }
-
-        return extracted;
-    }
