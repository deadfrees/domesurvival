-            BlockState refreshed =
-                    EnergyPipeBlock.refreshConnections(level, pipePos, oldState);
-
-            if (!refreshed.equals(oldState)) {
-                level.setBlock(
-                        pipePos,
-                        refreshed,
-                        Block.UPDATE_NEIGHBORS | Block.UPDATE_CLIENTS
-                );
-            } else {
-                level.sendBlockUpdated(
-                        pipePos,
-                        oldState,
-                        oldState,
-                        Block.UPDATE_CLIENTS
-                );
-            }
-        }
-    }
