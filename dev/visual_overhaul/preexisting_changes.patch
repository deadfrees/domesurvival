-            receivedThisTick += stored;
-
-            if (stored > 0) {
-                active = true;
-                setChanged();
-            }
-
-            return stored;
-        }
-
-        return accepted;
-    }
-
-    private int extractLimited(int maxExtract, boolean simulate) {
