  quests: [
  {
    id: "574CF865DA07FAA8"
    title: "Под Куполом"
    icon: "minecraft:glass"
    tags: ["ds_visual_story"]
    x: 0.0d
    y: 0.0d
    shape: "hexagon"
    size: 1.18d
    icon_scale: 0.86d
    min_width: 340
    description: [
      "Ты начинаешь не с пустого мира, а с последнего безопасного места.",
      "",
      "Эта книга — общий маршрут выживших. Джозеф Куппер ведёт свои проекты отдельно, а здесь мы фиксируем то, что меняет жизнь всего поселения.",
      "",
      "Первое правило простое: пока Купол работает, он — дом. Снаружи действуют совсем другие правила.",
      "",
      "{\"text\":\"◆ Что сделать\",\"color\":\"gold\",\"bold\":true}",
      "{\"text\":\"Находиться внутри безопасной зоны стартового Купола.\",\"color\":\"white\"}",
      "",
      "{\"text\":\"◆ Как засчитывается\",\"color\":\"aqua\",\"bold\":true}",
      "{\"text\":\"Автоматически. Сервер сам определит, что вы внутри Купола.\",\"color\":\"gray\"}"
    ]
    tasks: [
      {
          id: "5701C6982DD28F03"
          type: "advancement"
          title: "Автоматически: находиться внутри стартового Купола"
